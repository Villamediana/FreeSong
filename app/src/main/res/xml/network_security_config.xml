<?xml version="1.0" encoding="utf-8"?>
<!-- Só HTTPS, e só certificados do sistema (um certificado instalado por terceiros não intercepta o app). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
