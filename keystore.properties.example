# Copie para keystore.properties (na raiz do projeto) e preencha com a SUA chave.
# keystore.properties está no .gitignore: nunca vai pro repositório.
# Sem este arquivo, o assembleRelease gera uma APK sem assinatura (assembleDebug funciona sempre).
storeFile=/caminho/para/sua-chave.jks
storePassword=
keyAlias=
keyPassword=
